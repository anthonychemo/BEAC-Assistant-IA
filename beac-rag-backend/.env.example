# Copier ce fichier en ".env" et renseigner les vraies valeurs (jamais commiter le .env reel).

# Supabase (Project Settings > Database > Connection string) - prioritaire sur
# postgres_user/password/host/port/db ci-dessous si renseignee.
DATABASE_URL_OVERRIDE=

# Fallback local (utilise seulement si DATABASE_URL_OVERRIDE est vide)
POSTGRES_USER=beac
POSTGRES_PASSWORD=beac_password
POSTGRES_DB=beac_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cloudflare R2 (meme bucket que le projet Scraping) - dashboard Cloudflare > R2 > Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beac-documents

# LLM via OpenRouter (gratuit) - https://openrouter.ai/keys
# Attention : ce champ n'est utilise que si "llm.model" est absent de
# config/config.yaml, qui est prioritaire quand il est renseigne (c'est le
# cas actuellement : voir config/config.yaml -> llm.model/fallback_model).
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# OCR (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\poppler\Library\bin
OCR_LANGS=fra+eng+spa

# API
API_HOST=0.0.0.0
API_PORT=8000
# Origines autorisees en CORS, separees par des virgules (front en dev = Vite sur 5173).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Jeton requis (header X-Admin-Token) pour /cache/clear. Laisser vide desactive la route.
ADMIN_API_TOKEN=
